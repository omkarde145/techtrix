# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Executable bash scripts
*.command text eol=lf
*.sh text eol=lf

# Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary media files
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.ico binary
*.pptx binary
